@@ -393,6 +415,50 @@ static void scale_and_flip(SDL_Surface *src_surface)
 
 	// Save output rect to be used by mouse functions
 	last_output_rect = dst_rect;
+
+#ifdef __amigaos__
+	/* SetEnv OPENTYRIAN_FPS 1: every five seconds, how many frames were
+	   shown, for measuring the port on a given machine. Any other value is
+	   a file the lines are added to (opened and closed each time, so it can
+	   be read while the game runs). */
+	static int fps_on = -1;
+	static const char *fps_file;
+	static Uint32 fps_start, fps_frames;
+	if (fps_on < 0)
+	{
+		fps_file = SDL_getenv("OPENTYRIAN_FPS");
+		fps_on = fps_file != NULL && fps_file[0] != '\0' && strcmp(fps_file, "0") != 0;
+		if (fps_on && strcmp(fps_file, "1") == 0)
+			fps_file = NULL;
+		fps_start = SDL_GetTicks();
+		fps_frames = 0;
+	}
+	if (fps_on)
+	{
+		fps_frames += 1;
+		const Uint32 now = SDL_GetTicks();
+		if (now - fps_start >= 5000)
+		{
+			const Uint32 ms = now - fps_start;
+			char line[96];
+			SDL_snprintf(line, sizeof(line), "fps: %u frames in %u ms (%u.%u a second)",
+			             (unsigned)fps_frames, (unsigned)ms,
+			             (unsigned)(fps_frames * 1000 / ms), (unsigned)(fps_frames * 10000 / ms % 10));
+			FILE *f = fps_file != NULL ? fopen(fps_file, "a") : NULL;
+			if (f != NULL)
+			{
+				fprintf(f, "%s\n", line);
+				fclose(f);
+			}
+			else
+			{
+				logInfo("%s", line);
+			}
+			fps_start = now;
+			fps_frames = 0;
+		}
+	}
+#endif
 }
 
